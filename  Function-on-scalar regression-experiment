        "\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from pathlib import Path\n",
        "import json\n",
        "import platform\n",
        "import matplotlib\n",
        "from io import BytesIO\n",
        "from PIL import Image\n",
        "\n",
        "ARTIFACT_DIR = Path(\"tvc_outputs\")\n",
        "ARTIFACT_DIR.mkdir(exist_ok=True)\n",
        "REG_PATH_SEED, REG_MC_SEED = 54321, 20260922\n",
        "REG_NOISE_COORDINATES = 64\n",
        "REG_PLOT_GRID_POINTS = 1001\n",
        "\n",
        "\n",
        "def save_figure(name):\n",
        "    buffer = BytesIO()\n",
        "    plt.savefig(buffer, format=\"png\", dpi=220, bbox_inches=\"tight\")\n",
        "    data = buffer.getvalue()\n",
        "    with Image.open(BytesIO(data)) as image:\n",
        "        image.load()\n",
        "    destination = ARTIFACT_DIR / name\n",
        "    temporary = destination.with_suffix(\".tmp\")\n",
        "    temporary.write_bytes(data)\n",
        "    temporary.replace(destination)\n",
        "\n",
        "\n",
        "def validate_sample_sizes(N, n_values):\n",
        "    values = np.asarray(n_values)\n",
        "    if values.ndim != 1 or len(values) == 0 or not np.all(values == values.astype(int)):\n",
        "        raise ValueError(\"n_values must be a nonempty one-dimensional integer sequence\")\n",
        "    values = values.astype(int)\n",
        "    if np.any(values < 1) or np.any(values > N) or np.any(np.diff(values) <= 0):\n",
        "        raise ValueError(\"n_values must be strictly increasing and lie in [1, N]\")\n",
        "    return values\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# FUNCTION-ON-SCALAR REGRESSION WITH MARTINGALE SCORE\n",
        "# ============================================================\n",
        "\n",
        "def make_true_beta(t):\n",
        "    return np.vstack([\n",
        "        1.5 * np.sin(2.0 * np.pi * t),\n",
        "        1.0 * np.cos(2.0 * np.pi * t),\n",
        "        2.0 * (t - 0.5),\n",
        "    ])\n",
        "\n",
        "\n",
        "def make_error_basis(t, K=REG_NOISE_COORDINATES):\n",
        "    k = np.arange(1, K + 1)\n",
        "    basis = np.sqrt(2.0) * np.sin(np.pi * k[:, None] * t[None, :])\n",
        "    lam = 1.0 / (k ** 2)\n",
        "    return basis, lam\n",
        "\n",
        "\n",
        "def simulate_regression_path(\n",
        "    N=5000,\n",
        "    d=3,\n",
        "    m_grid=REG_PLOT_GRID_POINTS,\n",
        "    K=REG_NOISE_COORDINATES,\n",
        "    ar=0.65,\n",
        "    seed=REG_PATH_SEED,\n",
        "):\n",
        "    \"\"\"Simulate the design and the first K orthonormal noise coefficients.\n",
        "\n",
        "    Pass m_grid=None for runs that only use the coefficient representation.\n",
        "    \"\"\"\n",
        "    if d != 3:\n",
        "        raise ValueError(\"The specified coefficient functions require d=3\")\n",
        "    if N < 1 or K < 1 or not 0 <= ar < 1:\n",
        "        raise ValueError(\"Require N>=1, K>=1 and 0<=ar<1\")\n",
        "    if m_grid is not None and m_grid <= K:\n",
        "        raise ValueError(\"The display grid requires m_grid>K\")\n",
        "\n",
        "    design_seed = np.random.SeedSequence([seed, 101])\n",
        "    design_rng = np.random.Generator(np.random.PCG64(design_seed))\n",
        "    U = design_rng.uniform(-1.0, 1.0, size=(N - 1, d))\n",
        "    X = np.zeros((N, d))\n",
        "    for n in range(1, N):\n",
        "        X[n] = ar * X[n - 1] + (1.0 - ar) * U[n - 1]\n",
        "\n",
        "    sigma = 0.65 + 0.20 * np.tanh(X[:, 0])\n",
        "    k = np.arange(1, K + 1)\n",
        "    Z = np.empty((N, K))\n",
        "    for j in range(K):\n",
        "        coordinate_seed = np.random.SeedSequence([seed, 202, j + 1])\n",
        "        coordinate_rng = np.random.Generator(np.random.PCG64(coordinate_seed))\n",
        "        Z[:, j] = coordinate_rng.standard_normal(N)\n",
        "    error_coefficients = sigma[:, None] * Z / k\n",
        "\n",
        "    # The sine basis is orthonormal in continuous L2([0,1]).\n",
        "    trace_cov = np.sum(1.0 / k**2)\n",
        "    cond_D2 = np.sum(X**2, axis=1) * sigma**2 * trace_cov\n",
        "    q_limit = (1.0 - ar) / (3.0 * (1.0 + ar))\n",
        "    sample = {\n",
        "        \"X\": X,\n",
        "        \"error_coefficients\": error_coefficients,\n",
        "        \"sigma\": sigma,\n",
        "        \"cond_D2\": cond_D2,\n",
        "        \"Q_limit\": q_limit * np.eye(d),\n",
        "        \"lambda_min_Q_limit\": q_limit,\n",
        "    }\n",
        "    if m_grid is not None:\n",
        "        t = np.linspace(0.0, 1.0, m_grid)\n",
        "        beta0 = make_true_beta(t)\n",
        "        basis, _ = make_error_basis(t, K=K)\n",
        "        eps = error_coefficients @ basis\n",
        "        sample.update(t=t, beta0=beta0, basis=basis, eps=eps, Y=X @ beta0 + eps)\n",
        "    return sample\n",
        "\n",
        "\n",
        "def ols_path(sample, n_values):\n",
        "    X = sample[\"X\"]\n",
        "    error_coefficients = sample[\"error_coefficients\"]\n",
        "    d = X.shape[1]\n",
        "    cum_xx = np.zeros((d, d))\n",
        "    cum_xe = np.zeros((d, error_coefficients.shape[1]))\n",
        "    previous = 0\n",
        "    out = []\n",
        "\n",
        "    for n in validate_sample_sizes(X.shape[0], n_values):\n",
        "        block = X[previous:n]\n",
        "        cum_xx += block.T @ block\n",
        "        cum_xe += block.T @ error_coefficients[previous:n]\n",
        "        previous = n\n",
        "\n",
        "        Qn = cum_xx / n\n",
        "        lam_min = np.linalg.eigvalsh(Qn)[0]\n",
        "        if lam_min <= 1e-12:\n",
        "            raise np.linalg.LinAlgError(\n",
        "                f\"Design is singular or numerically ill-conditioned at n={n}; \"\n",
        "                \"this replication is not silently omitted.\"\n",
        "            )\n",
        "\n",
        "        # OLS satisfies beta_hat - beta0 = (X^T X)^(-1) X^T epsilon.\n",
        "        error_basis_coefficients = np.linalg.solve(cum_xx, cum_xe)\n",
        "        result = {\n",
        "            \"n\": int(n),\n",
        "            \"Qn\": Qn,\n",
        "            \"lambda_min\": lam_min,\n",
        "            \"error\": np.linalg.norm(error_basis_coefficients, ord=\"fro\"),\n",
        "            \"error_basis_coefficients\": error_basis_coefficients,\n",
        "        }\n",
        "        if \"basis\" in sample:\n",
        "            result[\"beta_hat\"] = sample[\"beta0\"] + error_basis_coefficients @ sample[\"basis\"]\n",
        "        out.append(result)\n",
        "\n",
        "    return out\n",
        "\n",
        "\n",
        "def regression_diagnostics(sample, results, rhos=(0.55, 0.65, 0.75, 1.0)):\n",
        "    n_vals = np.array([r[\"n\"] for r in results], dtype=float)\n",
        "    errors = np.array([r[\"error\"] for r in results], dtype=float)\n",
        "    lambda_min = np.array([r[\"lambda_min\"] for r in results], dtype=float)\n",
        "\n",
        "    scaled = {\n",
        "        rho: n_vals ** (1.0 - rho) * errors\n",
        "        for rho in rhos\n",
        "    }\n",
        "\n",
        "    cond_D2 = sample[\"cond_D2\"]\n",
        "    n_all = np.arange(1, len(cond_D2) + 1, dtype=float)\n",
        "    weighted_partial = {\n",
        "        rho: np.cumsum(cond_D2 / (n_all ** (2.0 * rho)))\n",
        "        for rho in rhos\n",
        "    }\n",
        "\n",
        "    return {\n",
        "        \"n\": n_vals,\n",
        "        \"errors\": errors,\n",
        "        \"lambda_min\": lambda_min,\n",
        "        \"lambda_min_limit\": sample[\"lambda_min_Q_limit\"],\n",
        "        \"scaled\": scaled,\n",
        "        \"weighted_partial\": weighted_partial,\n",
        "    }\n",
        "\n",
        "\n",
        "def plot_coefficient_recovery(sample, result):\n",
        "    t = sample[\"t\"]\n",
        "    beta0 = sample[\"beta0\"]\n",
        "    beta_hat = result[\"beta_hat\"]\n",
        "    n = result[\"n\"]\n",
        "    K = sample[\"error_coefficients\"].shape[1]\n",
        "\n",
        "    plt.figure(figsize=(8, 5))\n",
        "    for j, color in enumerate((\"tab:blue\", \"tab:orange\", \"tab:purple\")):\n",
        "        plt.plot(t, beta0[j], color=color, linewidth=2, label=fr\"$\\beta_{{0{j+1}}}$\")\n",
        "        plt.plot(t, beta_hat[j], \"--\", color=color, linewidth=1.6,\n",
        "                 label=fr\"$\\widehat\\beta_{{{j+1}}}$\")\n",
        "    plt.xlabel(r\"$t$\")\n",
        "    plt.ylabel(\"Coefficient value\")\n",
        "    plt.title(fr\"Coefficient functions ($n={n}$, $K={K}$)\", pad=51)\n",
        "    plt.legend(loc=\"lower center\", bbox_to_anchor=(0.5, 1.01), ncol=3)\n",
        "    plt.tight_layout()\n",
        "    save_figure(\"regression_coefficients.png\")\n",
        "    plt.show()\n",
        "\n",
        "def plot_regression_error(diag):\n",
        "    plt.figure(figsize=(7, 4))\n",
        "    plt.loglog(diag[\"n\"], diag[\"errors\"], marker=\"o\")\n",
        "    plt.xlabel(\"n\")\n",
        "    plt.ylabel(r\"$\\|\\widehat\\beta_n^{(K)}-\\beta_0\\|_{\\mathrm{H}^d}$\")\n",
        "    plt.title(\"Functional OLS coefficient error\")\n",
        "    plt.tight_layout()\n",
        "    save_figure(\"regression_error.png\")\n",
        "    plt.show()\n",
        "\n",
        "\n",
        "def plot_scaled_regression_errors(diag, rhos=(0.55, 0.65, 0.75, 1.0), ax=None):\n",
        "    standalone = ax is None\n",
        "    if standalone:\n",
        "        _, ax = plt.subplots(figsize=(7, 4))\n",
        "    for rho in rhos:\n",
        "        ax.loglog(diag[\"n\"], diag[\"scaled\"][rho], marker=\"o\", label=fr\"$\\rho={rho}$\")\n",
        "    ax.set(xlabel=r\"$n$\", ylabel=r\"$n^{1-\\rho}\\|\\widehat\\beta_n^{(K)}-\\beta_0\\|$\",\n",
        "           title=\"Scaled OLS errors\")\n",
        "    ax.legend(loc=\"upper center\", bbox_to_anchor=(0.5, -0.23), ncol=2)\n",
        "    if standalone:\n",
        "        plt.tight_layout()\n",
        "        save_figure(\"sim_regression_scaled_errors_corrected.png\")\n",
        "        plt.show()\n",
        "\n",
        "\n",
        "def plot_lambda_min(diag, ax=None):\n",
        "    standalone = ax is None\n",
        "    if standalone:\n",
        "        _, ax = plt.subplots(figsize=(7, 4))\n",
        "    ax.semilogx(diag[\"n\"], diag[\"lambda_min\"], marker=\"o\", label=r\"$\\lambda_{\\min}(Q_n)$\")\n",
        "    ax.axhline(diag[\"lambda_min_limit\"], color=\"0.35\", linestyle=\"--\", label=r\"$q$\")\n",
        "    ax.set(xlabel=r\"$n$\", ylabel=\"Smallest eigenvalue\", title=\"Design stability\")\n",
        "    ax.legend(loc=\"lower right\")\n",
        "    if standalone:\n",
        "        plt.tight_layout()\n",
        "        save_figure(\"sim_regression_lambda_min_corrected.png\")\n",
        "        plt.show()\n",
        "\n",
        "\n",
        "def plot_regression_diagnostics(diag, rhos):\n",
        "    _, (ax_design, ax_rate) = plt.subplots(1, 2, figsize=(9, 3.7), layout=\"constrained\")\n",
        "    plot_lambda_min(diag, ax=ax_design)\n",
        "    plot_scaled_regression_errors(diag, rhos=rhos, ax=ax_rate)\n",
        "    save_figure(\"regression_diagnostics.png\")\n",
        "    plt.show()\n",
        "\n",
        "\n",
        "def plot_regression_conditional_series(diag, N, rhos=(0.55, 0.65, 0.75, 1.0)):\n",
        "    n_all = np.arange(1, N + 1)\n",
        "    plt.figure(figsize=(7, 4))\n",
        "    for rho in rhos:\n",
        "        plt.semilogx(\n",
        "            n_all,\n",
        "            diag[\"weighted_partial\"][rho],\n",
        "            label=fr\"$\\rho={rho}$\",\n",
        "        )\n",
        "    plt.xlabel(\"N\")\n",
        "    plt.ylabel(\n",
        "        r\"$\\sum_{n\\leq N}n^{-2\\rho}E(\\|D_n^{(K)}\\|^2\\mid\\mathcal{F}_{n-1})$\"\n",
        "    )\n",
        "    plt.title(\"Conditional-moment series for the regression score\")\n",
        "    plt.legend()\n",
        "    plt.tight_layout()\n",
        "    save_figure(\"regression_conditional_series.png\")\n",
        "    plt.show()\n",
        "\n",
        "\n",
        "def monte_carlo_regression(\n",
        "    repetitions=100,\n",
        "    N=3000,\n",
        "    n_values=(100, 200, 400, 800, 1600, 3000),\n",
        "    seed=REG_MC_SEED,\n",
        "    K=REG_NOISE_COORDINATES,\n",
        "):\n",
        "    n_values = validate_sample_sizes(N, n_values)\n",
        "    if repetitions < 1:\n",
        "        raise ValueError(\"repetitions must be positive\")\n",
        "    master = np.random.Generator(np.random.PCG64(seed))\n",
        "    errors = np.empty((repetitions, len(n_values)))\n",
        "\n",
        "    for r in range(repetitions):\n",
        "        path_seed = int(master.integers(0, 2**32 - 1))\n",
        "        sample = simulate_regression_path(N=N, K=K, seed=path_seed, m_grid=None)\n",
        "        errors[r] = [result[\"error\"] for result in ols_path(sample, n_values)]\n",
        "\n",
        "    return n_values, errors\n",
        "\n",
        "\n",
        "def plot_regression_monte_carlo(n_values, errors, K=REG_NOISE_COORDINATES):\n",
        "    if not np.all(np.isfinite(errors)):\n",
        "        raise ValueError(\"Non-finite Monte Carlo errors must be investigated\")\n",
        "    n_values = np.asarray(n_values)\n",
        "    q25, median, q75 = np.quantile(errors, [.25, .5, .75], axis=0, method=\"linear\")\n",
        "    reference = median[0] * np.sqrt(n_values[0] / n_values)\n",
        "\n",
        "    plt.figure(figsize=(8, 4))\n",
        "    plt.loglog(n_values, median, marker=\"o\", label=\"Median\")\n",
        "    plt.fill_between(n_values, q25, q75, alpha=0.2, label=\"25%–75%\")\n",
        "    plt.loglog(n_values, reference, \"--\", color=\"0.45\", label=r\"$n^{-1/2}$ reference\")\n",
        "    plt.xlabel(r\"$n$\")\n",
        "    plt.ylabel(r\"$\\|\\widehat\\beta_n^{(K)}-\\beta_0\\|_{\\mathbb{H}^3}$\")\n",
        "    plt.title(f\"Monte Carlo OLS error ({errors.shape[0]} paths, K={K})\")\n",
        "    plt.legend()\n",
        "    plt.tight_layout()\n",
        "    save_figure(\"regression_montecarlo.png\")\n",
        "    plt.show()\n",
        "\n",
        "    slope = np.polyfit(np.log(n_values), np.log(median), 1)[0]\n",
        "    return np.column_stack((n_values, median, q25, q75)), slope\n"
      ]
